  },
  "dependencies": {
    "@jellyfin/libass-wasm": "4.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
